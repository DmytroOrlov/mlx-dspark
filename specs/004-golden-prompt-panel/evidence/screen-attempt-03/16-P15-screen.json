    "output_text": "```python\nfrom typing import List\nfrom collections import defaultdict\n\n\ndef group_anagrams(words: List[str]) -> List[List[str]]:\n    \"\"\"\n    Group a list of strings into groups of anagrams.\n    \n    An anagram is a word or phrase formed by rearranging the letters of another,\n    typically using all the original letters exactly once.\n    \n    Args:\n        words: A list of strings to be grouped into anagram groups.\n        \n    Returns:\n        A list of lists, where each inner list contains words that are anagrams of each other.\n        The order of groups and the order of words within each group may vary.\n        \n    Example:\n        >>> group_anagrams([\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"])\n        [['eat', 'tea', 'ate'], ['tan', 'nat'], ['bat']]\n    \"\"\"\n    anagram_groups: dict[str, List[str]] = defaultdict(list)\n    \n    for word in words:\n        # Use the sorted characters as the key for anagram grouping\n        key = ''.join(sorted(word))\n        anagram_groups[key].append(word)\n    \n    return list(anagram_groups.values())\n\n\n# Tests\ndef test_group_anagrams_basic():\n    \"\"\"Test basic anagram grouping.\"\"\"\n    result = group_anagrams([\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"])\n    # Convert to a set of frozensets for comparison (order doesn't matter)\n    result_set = {frozenset(group) for group in result}\n    expected_set = {\n        frozenset([\"eat\", \"tea\", \"ate\"]),\n        frozenset([\"tan\", \"nat\"]),\n        frozenset([\"bat\"])\n    }\n    assert result_set == expected_set, f\"Expected {expected_set}, got {result_set}\"\n\n\ndef test_group_anagrams_single_word():\n    \"\"\"Test with a single word.\"\"\"\n    result = group_anagrams([\"hello\"])\n    assert result == [[\"hello\"]], f\"Expected [['hello']], got {result}\"\n\n\ndef test_group_anagrams_empty_list():\n    \"\"\"Test with an empty list.\"\"\"\n    result = group_anagrams([])\n    assert result == [], f\"Expected [], got {result}\"\n\n\ndef test_group_anagrams_no_anagrams():\n    \"\"\"Test with words that have no anagrams.\"\"\"\n    result =",
