    "output_text": "```python\n\"\"\"\nThread-safe singleton implementation in Python.\n\nThis module provides a production-quality, thread-safe singleton class\nusing the double-checked locking pattern with proper synchronization.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport threading\nfrom typing import Any, ClassVar, Optional, Type, TypeVar\n\nT = TypeVar(\"T\")\n\n\nclass SingletonMeta(type):\n    \"\"\"\n    A metaclass that implements a thread-safe singleton pattern.\n\n    This metaclass ensures that only one instance of a class is ever created,\n    even in a multi-threaded environment. It uses double-checked locking\n    to minimize the overhead of acquiring the lock after the instance has\n    been created.\n\n    Usage:\n        class MySingleton(metaclass=SingletonMeta):\n            def __init__(self, *args: Any, **kwargs: Any) -> None:\n                super().__init__(*args, **kwargs)\n\n    Attributes:\n        _instance: The singleton instance, or None if not yet created.\n        _lock: A reentrant lock used to synchronize instance creation.\n    \"\"\"\n\n    _instance: ClassVar[Optional[Any]] = None\n    _lock: ClassVar[threading.Lock] = threading.Lock()\n\n    def __call__(cls: Type[T], *args: Any, **kwargs: Any) -> T:\n        \"\"\"\n        Create or return the singleton instance.\n\n        Uses double-checked locking: first check if the instance exists\n        without acquiring the lock (fast path), and if not, acquire the\n        lock and check again before creating the instance (slow path).\n\n        Args:\n            *args: Positional arguments passed to the class constructor.\n            **kwargs: Keyword arguments passed to the class constructor.\n\n        Returns:\n            The singleton instance of the class.\n        \"\"\"\n        # First check: no lock needed (fast path)\n        if cls._instance is None:\n            # Acquire lock for thread-safe creation\n            with cls._lock:\n                # Second check: another thread may have created the instance\n                if cls._instance is None:\n                    cls._instance = super().__call__(*args, **kwargs)\n        return cls._instance\n\n    def __new__(cls: Type[T], *args: Any, **kwargs: Any) -> T:\n        \"\"\"\n        Prevent direct instantiation via __new__.\n\n        This ensures that the singleton is only created through __call__,",
