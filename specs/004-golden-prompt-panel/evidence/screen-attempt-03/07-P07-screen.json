    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_char(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the string.\n    \n    Args:\n        s: The input string to search.\n        \n    Returns:\n        The first character that appears exactly once, or None if no such character exists.\n    \"\"\"\n    char_count = Counter(s)\n    for char in s:\n        if char_count[char] == 1:\n            return char\n    return None\n\n\nimport unittest\n\n\nclass TestFirstNonRepeatingChar(unittest.TestCase):\n    \"\"\"Unit tests for first_non_repeating_char.\"\"\"\n    \n    def test_simple_case(self):\n        \"\"\"Test with a simple string where the first char is non-repeating.\"\"\"\n        self.assertEqual(first_non_repeating_char(\"aabbcc\"), None)\n        self.assertEqual(first_non_repeating_char(\"aabbc\"), \"c\")\n        self.assertEqual(first_non_repeating_char(\"abcabc\"), None)\n        self.assertEqual(first_non_repeating_char(\"aabbccdd\"), None)\n        self.assertEqual(first_non_repeating_char(\"aabbccdde\"), \"e\")\n    \n    def test_single_character(self):\n        \"\"\"Test with a single character string.\"\"\"\n        self.assertEqual(first_non_repeating_char(\"a\"), \"a\")\n        self.assertEqual(first_non_repeating_char(\"b\"), \"b\")\n    \n    def test_empty_string(self):\n        \"\"\"Test with an empty string.\"\"\"\n        self.assertIsNone(first_non_repeating_char(\"\"))\n    \n    def test_all_repeating(self):\n        \"\"\"Test where all characters repeat.\"\"\"\n        self.assertIsNone(first_non_repeating_char(\"aabb\"))\n        self.assertIsNone(first_non_repeating_char(\"abab\"))\n        self.assertIsNone(first_non_repeating_char(\"aaaa\"))\n    \n    def test_first_char_non_repeating(self):\n        \"\"\"Test where the very first character is non-repeating.\"\"\"\n        self.assertEqual(first_non_repeating_char(\"abc\"), \"a\")\n        self.assertEqual(first_non_repeating_char(\"abca\"), \"b\")\n    \n    def test_last_char_non_repeating(self):\n        \"\"\"Test where only the last character is non-repeating.\"\"\"\n        self.assertEqual(first_non_repeating_char(\"aabbccdd\"), None)\n        self.assertEqual(first_non_repeating_char(\"aabbccd\"), \"d\")\n    \n    def test_mixed",
