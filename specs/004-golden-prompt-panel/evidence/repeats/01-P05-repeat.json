    "output_text": "```python\ndef merge_sorted_lists(list1: list, list2: list) -> list:\n    \"\"\"\n    Merge two sorted lists into a single sorted list.\n    \n    Args:\n        list1: First sorted list (in non-decreasing order).\n        list2: Second sorted list (in non-decreasing order).\n    \n    Returns:\n        A new sorted list containing all elements from both input lists.\n    \"\"\"\n    merged = []\n    i, j = 0, 0\n    len1, len2 = len(list1), len(list2)\n    \n    # Compare elements from both lists and append the smaller one\n    while i < len1 and j < len2:\n        if list1[i] <= list2[j]:\n            merged.append(list1[i])\n            i += 1\n        else:\n            merged.append(list2[j])\n            j += 1\n    \n    # Append any remaining elements from list1\n    while i < len1:\n        merged.append(list1[i])\n        i += 1\n    \n    # Append any remaining elements from list2\n    while j < len2:\n        merged.append(list2[j])\n        j += 1\n    \n    return merged\n\n\ndef test_merge_sorted_lists():\n    \"\"\"Test cases for merge_sorted_lists.\"\"\"\n    \n    # Test 1: Basic merge\n    assert merge_sorted_lists([1, 3, 5], [2, 4, 6]) == [1, 2, 3, 4, 5, 6]\n    \n    # Test 2: One list is empty\n    assert merge_sorted_lists([], [1, 2, 3]) == [1, 2, 3]\n    assert merge_sorted_lists([1, 2, 3], []) == [1, 2, 3]\n    \n    # Test 3: Both lists are empty\n    assert merge_sorted_lists([], []) == []\n    \n    # Test 4: Lists with duplicate elements\n    assert merge_sorted_lists([1, 2, 2, 3], [2, 3, 4]) == [1, 2, 2, 2, 3, 3, 4]\n    \n    # Test 5: All elements in list1 are smaller than list2\n    assert merge_sorted_lists([1, 2, 3],",
