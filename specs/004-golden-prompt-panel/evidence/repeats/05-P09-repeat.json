    "output_text": "```python\ndef are_anagrams(s1: str, s2: str) -> bool:\n    \"\"\"\n    Determine whether two strings are anagrams of each other.\n    \n    Two strings are anagrams if they contain the same characters with the same frequencies,\n    ignoring case and non-alphabetic characters.\n    \n    Args:\n        s1: First string\n        s2: Second string\n        \n    Returns:\n        True if s1 and s2 are anagrams, False otherwise.\n    \"\"\"\n    # Normalize: convert to lowercase and keep only alphabetic characters\n    s1_clean = ''.join(c.lower() for c in s1 if c.isalpha())\n    s2_clean = ''.join(c.lower() for c in s2 if c.isalpha())\n    \n    # Quick length check\n    if len(s1_clean) != len(s2_clean):\n        return False\n    \n    # Count character frequencies\n    from collections import Counter\n    return Counter(s1_clean) == Counter(s2_clean)\n\n\n# Tests\ndef test_are_anagrams():\n    # Basic anagrams\n    assert are_anagrams(\"listen\", \"silent\") == True\n    assert are_anagrams(\"hello\", \"world\") == False\n    \n    # Case insensitivity\n    assert are_anagrams(\"Listen\", \"Silent\") == True\n    assert are_anagrams(\"Astronomer\", \"Moon starer\") == True\n    \n    # Non-alphabetic characters are ignored\n    assert are_anagrams(\"Astronomer\", \"Moon starer\") == True\n    assert are_anagrams(\"Astronomer\", \"Moon starer!\") == True\n    assert are_anagrams(\"hello\", \"h e l l o\") == True\n    \n    # Empty strings\n    assert are_anagrams(\"\", \"\") == True\n    assert are_anagrams(\"\", \"a\") == False\n    \n    # Single characters\n    assert are_anagrams(\"a\", \"a\") == True\n    assert are_anagrams(\"a\", \"b\") == False\n    \n    # Different lengths\n    assert are_anagrams(\"abc\", \"abcd\") == False\n    \n    # Same characters, different order\n    assert are_anagrams(\"abc\", \"cba\") == True\n    \n    # Repeated characters\n    assert are_anagrams(\"aab\", \"aba\") == True\n    assert are_anagrams(\"aab\", \"abb\") == False\n    \n    print(\"All tests passed!\")\n\n\nif __name__ == \"__main__",
