    "output_text": "```python\ndef merge_sorted_lists(list1: list, list2: list) -> list:\n    \"\"\"\n    Merge two sorted lists into a single sorted list.\n    \n    Args:\n        list1: A sorted list of elements.\n        list2: A sorted list of elements.\n    \n    Returns:\n        A new sorted list containing all elements from both input lists.\n    \"\"\"\n    if not list1:\n        return list(list2)\n    if not list2:\n        return list(list1)\n    \n    result = []\n    i, j = 0, 0\n    len1, len2 = len(list1), len2 = len(list2)\n    \n    while i < len1 and j < len2:\n        if list1[i] <= list2[j]:\n            result.append(list1[i])\n            i += 1\n        else:\n            result.append(list2[j])\n            j += 1\n    \n    # Append any remaining elements\n    if i < len1:\n        result.extend(list1[i:])\n    if j < len2:\n        result.extend(list2[j:])\n    \n    return result\n\n\ndef test_merge_sorted_lists():\n    \"\"\"Test the merge_sorted_lists function with various cases.\"\"\"\n    \n    # Test 1: Basic merge\n    assert merge_sorted_lists([1, 3, 5], [2, 4, 6]) == [1, 2, 3, 4, 5, 6]\n    \n    # Test 2: One list is empty\n    assert merge_sorted_lists([], [1, 2, 3]) == [1, 2, 3]\n    assert merge_sorted_lists([1, 2, 3], []) == [1, 2, 3]\n    \n    # Test 3: Both lists are empty\n    assert merge_sorted_lists([], []) == []\n    \n    # Test 4: All elements in list1 are smaller\n    assert merge_sorted_lists([1, 2, 3], [4, 5, 6]) == [1, 2, 3, 4, 5, 6]\n    \n    # Test 5: All elements in list2 are smaller\n    assert merge_sorted_lists([4, 5, 6], [1, 2, 3]) == [1, 2,",
