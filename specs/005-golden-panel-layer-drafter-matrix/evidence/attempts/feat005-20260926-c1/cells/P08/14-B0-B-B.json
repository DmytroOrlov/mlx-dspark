    "output_text": "```python\n\"\"\"\nA production-quality implementation of a stack data structure.\n\nThis module provides a generic, type-safe stack with O(1) amortized\npush/pop/peek/is_empty operations. It is implemented using a Python\nlist as the underlying storage, which gives us efficient append/pop\nat the end of the list.\n\nThe stack is fully generic via Python's type hints (PEP 585 / PEP 604\nsyntax, compatible with Python 3.9+).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TypeVar, Generic\n\nT = TypeVar(\"T\")\n\n\nclass Stack(Generic[T]):\n    \"\"\"\n    A generic LIFO (Last-In, First-Out) stack.\n\n    Attributes:\n        _items: Internal list storing the stack elements.\n\n    Example:\n        >>> s = Stack[int]()\n        >>> s.push(1)\n        >>> s.push(2)\n        >>> s.peek()\n        2\n        >>> s.pop()\n        2\n        >>> s.pop()\n        1\n        >>> s.is_empty()\n        True\n    \"\"\"\n\n    def __init__(self, initial_items: list[T] | None = None) -> None:\n        \"\"\"\n        Initialize the stack.\n\n        Args:\n            initial_items: Optional list of items to seed the stack with.\n                           The first element of the list becomes the\n                           bottom of the stack; the last element becomes\n                           the top. If None, the stack starts empty.\n\n        Raises:\n            TypeError: If initial_items is not a list.\n        \"\"\"\n        if initial_items is None:\n            self._items: list[T] = []\n        else:\n            if not isinstance(initial_items, list):\n                raise TypeError(\n                    f\"initial_items must be a list, got {type(initial_items).__name__}\"\n                )\n            self._items = list(initial_items)  # defensive copy\n\n    def push(self, item: T) -> None:\n        \"\"\"\n        Push an item onto the top of the stack.\n\n        Args:\n            item: The item to push.\n\n        Time Complexity: O(1) amortized.\n        \"\"\"\n        self._items.append(item)\n\n    def pop(self) -> T:\n        \"\"\"\n        Remove and return the top item from the stack.\n\n        Returns:\n",
