    "output_text": "```python\n\"\"\"\nA production-quality implementation of a stack data structure.\n\nThis module provides a generic, type-safe stack with O(1) time complexity\nfor push, pop, and peek operations.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Generic, TypeVar, Optional\n\nT = TypeVar(\"T\")\n\n\nclass StackEmptyError(Exception):\n    \"\"\"Exception raised when an operation is performed on an empty stack.\"\"\"\n\n    def __init__(self, message: str = \"Stack is empty\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\n\nclass Stack(Generic[T]):\n    \"\"\"\n    A generic stack data structure.\n\n    The stack is implemented using a list as the underlying storage,\n    with O(1) time complexity for push, pop, and peek operations.\n\n    Type Parameters:\n        T: The type of elements in the stack.\n\n    Example:\n        >>> s = Stack[int]\n        >>> s.push(1)\n        >>> s.push(2)\n        >>> s.peek()\n        2\n        >>> s.pop()\n        2\n        >>> s.pop()\n        1\n        >>> s.is_empty()\n        True\n    \"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initialize an empty stack.\"\"\"\n        self._items: list[T] = []\n\n    def push(self, item: T) -> None:\n        \"\"\"\n        Push an item onto the top of the stack.\n\n        Args:\n            item: The item to push.\n\n        Time Complexity: O(1)\n        \"\"\"\n        self._items.append(item)\n\n    def pop(self) -> T:\n        \"\"\"\n        Remove and return the top item from the stack.\n\n        Returns:\n            The top item of the stack.\n\n        Raises:\n            StackEmptyError: If the stack is empty.\n\n        Time Complexity: O(1)\n        \"\"\"\n        if self.is_empty():\n            raise StackEmptyError(\"Cannot pop from an empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> T:\n        \"\"\"\n        Return the top item of the stack without removing it.\n\n        Returns:\n            The top item of the stack.\n\n        Raises:\n            StackEmptyError: If the stack is empty.\n\n        Time Complexity: O(1)\n        \"\"\"\n",
    "output_tokens": null,
