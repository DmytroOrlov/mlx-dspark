    "output_text": "```python\n\"\"\"\nA production-quality implementation of a stack data structure.\n\nThis module provides a generic, type-safe stack with O(1) time complexity\nfor push, pop, and peek operations.\n\"\"\"\n\nfrom __future__ import\n\nfrom typing import TypeVar, Optional, List\n\nT = TypeVar(\"T\")\n\n\nclass StackEmptyError(Exception):\n    \"\"\"Exception raised when an operation is attempted on an empty stack.\"\"\"\n\n    def __init__(self, message: str = \"Stack is empty\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\n\nclass Stack:\n    \"\"\"\n    A generic LIFO (Last In, First Out) stack.\n\n    This class provides a type-safe, production-quality implementation of a\n    stack with O(1) time complexity for push, pop, and peek operations.\n\n    Type Parameters:\n        T: The type of elements in the stack.\n\n    Example:\n        >>> s = Stack[int]()\n        >>> s.push(1)\n        >>> s.push(2)\n        >>> s.peek()\n        2\n        >>> s.pop()\n        2\n        >>> s.pop()\n        1\n        >>> s.is_empty()\n        True\n    \"\"\"\n\n    def __init__(self, initial: Optional[List[T]] = None) -> None:\n        \"\"\"\n        Initialize the stack.\n\n        Args:\n            initial: An optional list of elements to pre-populate the stack.\n                     The first element in the list will be at the bottom,\n                     and the last element will be at the top.\n\n        Raises:\n            None\n        \"\"\"\n        self._items: List[T] = []\n        if initial is not None:\n            # The last element in the list is the top of the stack\n            self._items = list(initial)\n\n    def push(self, item: T) -> None:\n        \"\"\"\n        Push an item onto the top of the stack.\n\n        Args:\n            item: The item to push.\n\n        Time Complexity: O(1)\n        \"\"\"\n        self._items.append(item)\n\n    def pop(self) -> T:\n        \"\"\"\n        Remove and return the top item from the stack.\n\n        Returns:\n            The top item of the stack.\n\n        Raises:\n            StackEmptyError: If the stack is empty.\n\n        Time",
