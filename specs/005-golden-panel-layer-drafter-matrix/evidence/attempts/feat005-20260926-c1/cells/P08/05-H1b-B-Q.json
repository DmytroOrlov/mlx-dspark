    "output_text": "```python\n\"\"\"\nA production-quality generic stack implementation in Python.\n\nThis module provides a type-safe, generic Stack class with standard\nstack operations: push, pop, peek, and is_empty.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Generic, TypeVar, Optional, List\n\nT = TypeVar(\"T\")\n\n\nclass Stack(Generic[T]):\n    \"\"\"\n    A generic LIFO (Last-In, First-Out) stack data structure.\n\n    The stack is implemented using an internal list for O(1) push and pop\n    operations. It supports type hints for static analysis and provides\n    clear error messages for invalid operations.\n\n    Example:\n        >>> stack = Stack[int]()\n        >>> stack.push(1)\n        >>> stack.push(2)\n        >>> stack.peek()\n        2\n        >>> stack.pop()\n        2\n        >>> stack.pop()\n        1\n        >>> stack.is_empty()\n        True\n    \"\"\"\n\n    def __init__(self, initial_items: Optional[List[T]] = None) -> None:\n        \"\"\"\n        Initialize the stack.\n\n        Args:\n            initial_items: Optional list of items to initialize the stack with.\n                           The last item in the list will be on top of the stack.\n\n        Raises:\n            TypeError: If initial_items is provided but is not a list.\n        \"\"\"\n        if initial_items is None:\n            self._items: List[T] = []\n        elif isinstance(initial_items, list):\n            self._items = list(initial_items)\n        else:\n            raise TypeError(\n                f\"initial_items must be a list or None, got {type(initial_items).__name__}\"\n            )\n\n    def push(self, item: T) -> None:\n        \"\"\"\n        Push an item onto the top of the stack.\n\n        Args:\n            item: The item to push onto the stack.\n\n        Time Complexity: O(1)\n        \"\"\"\n        self._items.append(item)\n\n    def pop(self) -> T:\n        \"\"\"\n        Remove and return the top item from the stack.\n\n        Returns:\n            The top item of the stack.\n\n        Raises:\n            IndexError: If the stack is empty.\n\n        Time Complexity: O(1)\n        \"\"\"\n        if self.is_empty():\n            raise IndexError(\"pop from empty stack\")\n       ",
