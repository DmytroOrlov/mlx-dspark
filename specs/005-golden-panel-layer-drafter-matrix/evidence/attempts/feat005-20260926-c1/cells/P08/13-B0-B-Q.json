    "output_text": "```python\n\"\"\"\nA production-quality implementation of a stack data structure.\n\nThis module provides a generic, type-safe stack with O(1) amortized\npush/pop/peek/is_empty operations. It includes comprehensive unit tests\nusing pytest.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TypeVar, Generic, Optional\n\nT = TypeVar(\"T\")\n\n\nclass Stack(Generic[T]):\n    \"\"\"\n    A generic stack (LIFO) data structure.\n\n    Operations:\n        push(item)   -> None       O(1)\n        pop()        -> T          O(1)\n        peek()       -> T          O(1)\n        is_empty()   -> bool       O(1)\n        __len__      -> int        O(1)\n        __bool__     -> bool       O(1)\n        __repr__     -> str        O(n)\n\n    Raises:\n        IndexError: If pop() or peek() is called on an empty stack.\n    \"\"\"\n\n    def __init__(self, initial_items: Optional[Iterable[T]] = None) -> None:\n        \"\"\"\n        Initialize the stack.\n\n        Args:\n            initial_items: An optional iterable of items to push onto the\n                           stack in order (first item becomes the bottom).\n        \"\"\"\n        self._items: list[T] = []\n        if initial_items is not None:\n            for item in initial_items:\n                self.push(item)\n\n    def push(self, item: T) -> None:\n        \"\"\"\n        Push an item onto the top of the stack.\n\n        Args:\n            item: The item to push.\n        \"\"\"\n        self._items.append(item)\n\n    def pop(self) -> T:\n        \"\"\"\n        Remove and return the top item from the stack.\n\n        Returns:\n            The item that was at the top of the stack.\n\n        Raises:\n            IndexError: If the stack is empty.\n        \"\"\"\n        if self.is_empty():\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> T:\n        \"\"\"\n        Return the top item without removing it.\n\n        Returns:\n            The item at the top of the stack.\n\n        Raises:\n            IndexError: If the stack is empty.\n        \"\"\"\n        if self.is_empty():\n            raise IndexError(\"peek from empty stack",
