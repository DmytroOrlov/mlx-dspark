    "output_text": "```python\nfrom typing import List, Dict, Set, Optional\nfrom collections import defaultdict\n\n\ndef topological_sort(graph: Dict[int, List[int]]) -> Optional[List[int]]:\n    \"\"\"\n    Perform topological sorting on a directed acyclic graph.\n    \n    Args:\n        graph: A dictionary representing the graph where keys are nodes and\n               values are lists of nodes that the key points to (edges).\n    \n    Returns:\n        A list of nodes in topological order, or None if the graph contains a cycle.\n    \"\"\"\n    # Build in-degree map and adjacency list\n    in_degree: Dict[int, int] = defaultdict(int)\n    adjacency: Dict[int, List[int]] = defaultdict(list)\n    \n    # Collect all nodes\n    all_nodes: Set[int] = set()\n    for node in graph:\n        all_nodes.add(node)\n        for neighbor in graph[node]:\n            all_nodes.add(neighbor)\n    \n    # Initialize in-degrees\n    for node in all_nodes:\n        in_degree[node] = 0\n    \n    # Build adjacency and in-degrees\n    for node in graph:\n        for neighbor in graph[node]:\n            adjacency[node].append(neighbor)\n            in_degree[neighbor] += 1\n    \n    # Use Kahn's algorithm\n    queue: List[int] = []\n    for node in all_nodes:\n        if in_degree[node] == 0:\n            queue.append(node)\n    \n    result: List[int] = []\n    while queue:\n        # For deterministic output, we could sort, but let's just pop from front\n        node = queue.pop(0)\n        result.append(node)\n        for neighbor in adjacency[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    \n    if len(result) != len(all_nodes):\n        return None  # Cycle detected\n    \n    return result\n\n\ndef has_cycle(graph: Dict[int, List[int]]) -> bool:\n    \"\"\"\n    Check if a directed graph contains a cycle.\n    \n    Args:\n        graph: A dictionary representing the graph where keys are nodes and\n               values are lists of nodes that the key points to (edges).\n    \n    Returns:\n        True if the graph contains a cycle, False otherwise.\n    \"\"\"\n    result = topological_sort(graph)\n   ",
