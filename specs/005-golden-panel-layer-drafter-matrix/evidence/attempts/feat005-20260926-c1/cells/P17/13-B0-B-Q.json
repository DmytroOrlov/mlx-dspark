    "output_text": "```python\n\"\"\"\nTopological sorting of a directed acyclic graph (DAG) with cycle detection.\n\nThis module provides a function to perform topological sorting using\nKahn's algorithm (BFS-based), which also detects cycles in the graph.\n\"\"\"\n\nfrom collections import deque\nfrom typing import Dict, List, Set, Tuple\n\n\ndef topological_sort(graph: Dict[int, List[int]]) -> List[int]:\n    \"\"\"\n    Perform topological sorting on a directed acyclic graph using Kahn's algorithm.\n\n    Args:\n        graph: A dictionary representing the graph where keys are nodes and\n               values are lists of nodes that the key node points to.\n               Example: {0: [1, 2], 1: [3], 2: [3], 3: []}\n\n    Returns:\n        A list of nodes in topological order. If the graph contains a cycle,\n        raises a ValueError.\n\n    Raises:\n        ValueError: If the graph contains a cycle.\n    \"\"\"\n    if not graph:\n        return []\n\n    # Build the in-degree map and ensure all nodes are present\n    in_degree: Dict[int, int] = {}\n    for node in graph:\n        if node not in in_degree:\n            in_degree[node] = 0\n        for neighbor in graph[node]:\n            if neighbor not in in_degree:\n                in_degree[neighbor] = 0\n            in_degree[neighbor] += 1\n\n    # Initialize queue with all nodes that have in-degree 0\n    queue: deque = deque()\n    for node, degree in in_degree.items():\n        if degree == 0:\n            queue.append(node)\n\n    result: List[int] = []\n\n    while queue:\n        node = queue.popleft()\n        result.append(node)\n\n        for neighbor in graph.get(node, []):\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n\n    # If the result doesn't contain all nodes, there's a cycle\n    if len(result) != len(in_degree):\n        raise ValueError(\"Graph contains a cycle\")\n\n    return result\n\n\ndef has_cycle(graph: Dict[int, List[int]]) -> bool:\n    \"\"\"\n    Check if a directed graph contains a cycle.\n\n    Args:\n        graph: A dictionary representing the graph where keys are",
