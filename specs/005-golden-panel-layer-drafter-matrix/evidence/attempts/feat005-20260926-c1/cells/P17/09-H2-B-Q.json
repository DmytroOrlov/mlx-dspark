    "output_text": "```python\nfrom typing import List, Dict, Set, Optional\nfrom collections import defaultdict, deque\n\n\ndef topological_sort(graph: Dict[int, List[int]]) -> Optional[List[int]]:\n    \"\"\"\n    Perform topological sorting on a directed acyclic graph.\n    \n    Args:\n        graph: A dictionary where keys are nodes and values are lists of\n               nodes that the key has an edge to (adjacency list).\n    \n    Returns:\n        A list of nodes in topological order, or None if the graph has a cycle.\n    \n    Raises:\n        No specific exceptions; returns None if a cycle is detected.\n    \"\"\"\n    # Build in-degree map and ensure all nodes are in the graph\n    in_degree: Dict[int, int] = {node: 0 for node in graph}\n    for node in graph:\n        for neighbor in graph[node]:\n            if neighbor not in in_degree:\n                in_degree[neighbor] = 0\n            in_degree[neighbor] += 1\n\n    # Find all nodes with in-degree 0\n    queue: deque = deque()\n    for node, degree in in_degree.items():\n        if degree == 0:\n            queue.append(node)\n\n    result: List[int] = []\n    while queue:\n        node = queue.popleft()\n        result.append(node)\n        for neighbor in graph.get(node, []):\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n\n    # If the result doesn't include all nodes, there's a cycle\n    if len(result) != len(in_degree):\n        return None\n\n    return result\n\n\ndef has_cycle(graph: Dict[int, List[int]]) -> bool:\n    \"\"\"\n    Check if a directed graph has a cycle.\n    \n    Args:\n        graph: A dictionary where keys are nodes and values are lists of\n               nodes that the key has an edge to (adjacency list).\n    \n    Returns:\n        True if the graph has a cycle, False otherwise.\n    \"\"\"\n    # Use the topological sort to detect cycles\n    return topological_sort(graph) is None\n\n\ndef t