    "output_text": "```python\nfrom typing import List, Set, Dict, Optional\nfrom collections import defaultdict, deque\n\n\ndef topological_sort(\n    num_nodes: int,\n    edges: List[tuple]\n) -> Optional[List[int]]:\n    \"\"\"\n    Perform topological sorting on a directed acyclic graph.\n    \n    Args:\n        num_nodes: The number of nodes in the graph (labeled 0 to num_nodes-1).\n        edges: A list of (u, v) tuples representing a directed edge from u to v.\n        \n    Returns:\n        A list of nodes in topological order, or None if the graph has a cycle.\n    \"\"\"\n    # Build the graph\n    in_degree: Dict[int, int] = {i: 0 for i in range(num_nodes)}\n    adjacency: Dict[int, List[int]] = {i: [] for i in range(num_nodes)}\n    \n    for u, v in edges:\n        if 0 <= u < num_nodes and 0 <= v < num_nodes:\n            adjacency[u].append(v)\n            in_degree[v] += 1\n        else:\n            raise ValueError(f\"Node {u} or {v} is out of range [0, {num_nodes-1}]\")\n    \n    # Use a queue for nodes with in-degree 0\n    queue: deque = deque()\n    for i in range(num_nodes):\n        if in_degree[i] == 0:\n            queue.append(i)\n    \n    result: List[int] = []\n    \n    while queue:\n        node = queue.popleft()\n        result.append(node)\n        for neighbor in adjacency[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    \n    # If the result doesn't include all nodes, there's a cycle\n    if len(result) != num_nodes:\n        return None\n    return result\n\n\ndef has_cycle(\n    num_nodes: int,\n    edges: List[tuple]\n) -> bool:\n    \"\"\"\n    Check if a directed graph has a cycle.\n    \n    Args:\n        num_nodes: The number of nodes in the graph (labeled 0 to num_nodes-1).\n        edges: A list of (u, v) tuples representing a directed edge from u to v.\n        \n    Returns:\n        True",
