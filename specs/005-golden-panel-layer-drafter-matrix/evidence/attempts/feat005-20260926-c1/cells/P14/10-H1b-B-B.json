    "output_text": "```python\ndef edit_distance(s: str, t: str) -> int:\n    \"\"\"\n    Compute the Levenshtein edit distance between two strings using dynamic programming.\n    \n    The edit distance is the minimum number of single-character operations (insertions,\n    deletions, or substitutions) required to transform string s into string t.\n    \n    Args:\n        s: The source string.\n        t: The target string.\n    \n    Returns:\n        The minimum number of edit operations needed to convert s to t.\n    \"\"\"\n    m = len(s)\n    n = len(t)\n    \n    # Create a 2D DP table where dp[i][j] represents the edit distance\n    # between s[:i] and t[:j]\n    dp = [[0] * (n + 1) for _ in range(m + 1)]\n    \n    # Base cases: transforming an empty string to t[:j] requires j insertions\n    for j in range(n + 1):\n        dp[0][j] = j\n    \n    # Base cases: transforming s[:i] to an empty string requires i deletions\n    for i in range(m + 1):\n        dp[i][0] = i\n    \n    # Fill the table\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            if s[i - 1] == t[j - 1]:\n                # Characters match, no operation needed\n                dp[i][j] = dp[i - 1][j - 1]\n            else:\n                # Take the minimum of three operations:\n                # 1. Substitution: dp[i-1][j-1] + 1\n                # 2. Deletion: dp[i-1][j] + 1\n                # 3. Insertion: dp[i][j-1] + 1\n                dp[i][j] = 1 + min(\n                    dp[i - 1][j - 1],  # substitution\n                    dp[i - 1][j],      # deletion\n                    dp[i][j - 1]       # insertion\n                )\n    \n    return dp[m][n]\n\n\ndef test_edit_distance():\n    \"\"\"Test cases for the edit_distance function.\"\"\"\n    # Test 1: Identical strings\n    assert edit_distance(\"",
