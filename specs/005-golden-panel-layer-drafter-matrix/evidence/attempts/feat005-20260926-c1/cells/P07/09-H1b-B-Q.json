    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the string.\n    \n    Args:\n        s: The input string to search.\n        \n    Returns:\n        The first character that appears only once in the string,\n        or None if no such character exists.\n    \"\"\"\n    char_count = Counter(s)\n    for char in s:\n        if char_count[char] == 1:\n            return char\n    return None\n\n\nimport unittest\n\n\nclass TestFirstNonRepeatingCharacter(unittest.TestCase):\n    \"\"\"Unit tests for first_non_repeating_character.\"\"\"\n\n    def test_simple_case(self):\n        \"\"\"Test with a simple string having a unique character.\"\"\"\n        self.assertEqual(first_non_repeating_character(\"aabbcc\"), None)\n        self.assertEqual(first_non_repeating_character(\"aabbc\"), \"c\")\n        self.assertEqual(first_non_repeating_character(\"aabc\"), \"a\")\n\n    def test_all_unique(self):\n        \"\"\"Test when all characters are unique.\"\"\"\n        self.assertEqual(first_non_repeating_character(\"abc\"), \"a\")\n        self.assertEqual(first_non_repeating_character(\"abcd\"), \"a\")\n\n    def test_all_repeating(self):\n        \"\"\"Test when all characters repeat.\"\"\"\n        self.assertIsNone(first_non_repeating_character(\"aabb\"))\n        self.assertIsNone(first_non_repeating_character(\"aaaa\"))\n        self.assertIsNone(first_non_repeating_character(\"aabbccdd\"))\n\n    def test_empty_string(self):\n        \"\"\"Test with an empty string.\"\"\"\n        self.assertIsNone(first_non_repeating_character(\"\"))\n\n    def test_single_character(self):\n        \"\"\"Test with a single character.\"\"\"\n        self.assertEqual(first_non_repeating_character(\"a\"), \"a\")\n\n    def test_case_sensitive(self):\n        \"\"\"Test that the function is case-sensitive.\"\"\"\n        self.assertEqual(first_non_repeating_character(\"Aa\"), \"A\")\n        self.assertEqual(first_non_repeating_character(\"aA\"), \"a\")\n        self.assertIsNone(first_non_repeating_character(\"AaAa\"))\n\n    def test_with_spaces(self):\n        \"\"\"Test with spaces in the string.\"\"\"\n        self.assertEqual(first_non_repeating_character(\"a b a\"), \"b\")\n        self.assertEqual(first_non_repeating_character(\"  a  b  a  b  c\"), \"c\")\n\n",
