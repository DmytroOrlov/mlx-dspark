    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_char(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the string.\n    \n    If no such character exists, return None.\n    \n    Args:\n        s: The input string to search.\n        \n    Returns:\n        The first character that appears exactly once, or None if all\n        characters are repeated.\n    \"\"\"\n    if not s:\n        return None\n\n    # Count the frequency of each character\n    char_count: Counter = Counter(s)\n\n    # Iterate through the string in order and return the first\n    # character with a count of 1\n    for char in s:\n        if char_count[char] == 1:\n            return char\n\n    return None\n\n\nif __name__ == \"__main__\":\n    import unittest\n\n    class TestFirstNonRepeatingChar(unittest.TestCase):\n        def test_simple_case(self) -> None:\n            \"\"\"Test a simple string with a non-repeating character.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"aabbcc\"), \"c\")\n\n        def test_first_char_is_non_repeating(self) -> None:\n            \"\"\"Test when the first character is the only non-repeating one.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"abc\"), \"a\")\n\n        def test_all_repeating(self) -> None:\n            \"\"\"Test when all characters are repeated.\"\"\"\n            self.assertIsNone(first_non_repeating_char(\"aabb\"))\n\n        def test_empty_string(self) -> None:\n            \"\"\"Test with an empty string.\"\"\"\n            self.assertIsNone(first_non_repeating_char(\"\"))\n\n        def test_single_character(self) -> None:\n            \"\"\"Test with a single character (non-repeating).\"\"\"\n            self.assertEqual(first_non_repeating_char(\"a\"), \"a\")\n\n        def test_mixed_repeating_and_non_repeating(self) -> None:\n            \"\"\"Test a string with a mix of repeating and non-repeating characters.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"aabbccdd\"), \"c\")\n\n        def test_non_repeating_at_end(self) -> None:\n            \"\"\"Test when the non-repeating character is at the end.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"aabbccdd e\"), \"e\")\n\n        def test_all_same_characters(self) -> None:\n            \"\"\"Test when all characters are the",
