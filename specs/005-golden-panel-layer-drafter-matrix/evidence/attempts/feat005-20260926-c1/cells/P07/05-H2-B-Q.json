    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_char(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the string.\n    \n    If no such character exists, return None.\n    \n    Args:\n        s: The input string.\n        \n    Returns:\n        The first character that appears exactly once, or None if no such character.\n        \n    Examples:\n        >>> first_non_repeating_char(\"aabbcc\")\n        >>> first_non_repeating_char(\"aabbc\")\n        'c'\n        >>> first_non_repeating_char(\"a\")\n        'a'\n        >>> first_non_repeating_char(\"\")\n        >>> first_non_repeating_char(\"aabb\")\n        >>> first_non_repeating_char(\"abcabc\")\n        >>> first_non_repeating_char(\"aA\")\n        'a'\n    \"\"\"\n    if not s:\n        return None\n\n    # Count the frequency of each character\n    char_count = Counter(s)\n\n    # Find the first character with a count of 1\n    for char in s:\n        if char_count[char] == 1:\n            return char\n\n    return None\n\n\nif __name__ == \"__main__\":\n    import unittest\n\n    class TestFirstNonRepeatingChar(unittest.TestCase):\n        def test_all_repeating(self):\n            self.assertIsNone(first_non_repeating_char(\"aabbcc\"))\n\n        def test_one_non_repeating_at_end(self):\n            self.assertEqual(first_non_repeating_char(\"aabbc\"), \"c\")\n\n        def test_single_char(self):\n            self.assertEqual(first_non_repeating_char(\"a\"), \"a\")\n\n        def test_empty_string(self):\n            self.assertIsNone(first_non_repeating_char(\"\"))\n\n        def test_all_repeating_no_non_repeating(self):\n            self.assertIsNone(first_non_repeating_char(\"aabb\"))\n\n        def test_all_repeating_multiple_chars(self):\n            self.assertIsNone(first_non_repeating_char(\"abcabc\"))\n\n        def test_case_sensitive(self):\n            # 'a' and 'A' are different characters\n            self.assertEqual(first_non_repeating_char(\"aA\"), \"a\")\n\n        def test_first_non_repeating_is_first in order(self):\n            # 'b' appears once, 'a' appears twice, 'c' appears once\n            # 'b' is the first non-repeating",
