    "output_text": "```python\nfrom collections import Counter\nfrom typing import Optional\n\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the given string.\n\n    Args:\n        s: The input string to search.\n\n    Returns:\n        The first character that appears exactly once in the string,\n        or None if no such character exists.\n    \"\"\"\n    char_count = Counter(s)\n    for char in s:\n        if char_count[char] == 1:\n            return char\n    return None\n\n\n# ---------- Unit Tests ----------\n\nimport unittest\n\n\nclass TestFirstNonRepeatingCharacter(unittest.TestCase):\n\n    def test_single_character(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"a\"), \"a\")\n\n    def test_all_unique(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"abc\"), \"a\")\n\n    def test_first_repeating_then_unique(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"aabbcc\"), None)\n\n    def test_mixed(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"aabbc\"), \"c\")\n\n    def test_first_char_repeats_later(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"abac\"), \"b\")\n\n    def test_all_repeating(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"aabb\"), None)\n\n    def test_empty_string(self) -> None:\n        self.assertIsNone(first_non_repeating_character(\"\"))\n\n    def test_spaces_count(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"a b a\"), \" \")\n\n    def test_case_sensitive(self) -> None:\n        self.assertEqual(first_non_repeating_character(\"AaBb\"), \"A\")\n\n    def test_long_string(self) -> None:\n        s = \"a\" * 1000 + \"b\" * 1000 + \"c\"\n        self.assertEqual(first_non_repeating_character(s), \"c\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n```\n\n### How It Works\n\n1. **Count characters** \u2013 `Counter(s)` builds a frequency map in O(n) time.\n2. **Scan in order** \u2013 Iterate through the original string (preserving order) and return the first character whose count is exactly 1.\n3. **Return",
