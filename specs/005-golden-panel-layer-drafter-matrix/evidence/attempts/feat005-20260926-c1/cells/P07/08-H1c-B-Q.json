    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_char(s: str) -> Optional[str]:\n    \"\"\"\n    Return the first non-repeating character in the string.\n    \n    If no such character exists, return None.\n    \n    Args:\n        s: The input string to search.\n        \n    Returns:\n        The first character that appears only once in the string, or None if no such character exists.\n    \"\"\"\n    if not s:\n        return None\n\n    # Count the frequency of each character\n    char_count = Counter(s)\n\n    # Find the first character with a count of 1\n    for char in s:\n        if char_count[char] == 1:\n            return char\n\n    return None\n\n\nif __name__ == \"__main__\":\n    import unittest\n\n    class TestFirstNonRepeatingChar(unittest.TestCase):\n        def test_simple_case(self):\n            \"\"\"Test a simple case with a non-repeating character.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"aabbcc\"), \"c\")\n\n        def test_all_repeating(self):\n            \"\"\"Test a string where all characters are repeated.\"\"\"\n            self.assertIsNone(first_non_repeating_char(\"aabbccdd\"))\n\n        def test_single_character(self):\n            \"\"\"Test a string with a single character.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"a\"), \"a\")\n\n        def test_empty_string(self):\n            \"\"\"Test an empty string.\"\"\"\n            self.assertIsNone(first_non_repeating_char(\"\"))\n\n        def test_first_char_is_non_repeating(self):\n            \"\"\"Test when the first character is the non-repeating one.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"abc\"), \"a\")\n\n        def test_last_char_is_non_repeating(self):\n            \"\"\"Test when the last character is the non-repeating one.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"aabbccdd e\"), \"e\")\n\n        def test_mixed_case(self):\n            \"\"\"Test that the function is case-sensitive.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"AaBbC\"), \"C\")\n\n        def test_with_spaces(self):\n            \"\"\"Test a string with spaces, where space is the non-repeating character.\"\"\"\n            self.assertEqual(first_non_repeating_char(\"a b a\"), \"b\")\n\n        def test_all_same_char(self):\n            \"\"\"Test a string",
