    "output_text": "```python\ndef merge_sorted_lists(list1: list, list2: list) -> list:\n    \"\"\"\n    Merge two sorted lists into a single sorted list.\n\n    Args:\n        list1: A sorted list of elements.\n        list2: A sorted list of elements.\n\n    Returns:\n        A new sorted list containing all elements from list1 and list2.\n\n    Time Complexity: O(n + m), where n = len(list1) and m = len(list2).\n    Space Complexity: O(n + m) for the result list.\n    \"\"\"\n    i = 0\n    j = 0\n    result = []\n\n    while i < len(list1) and j < len(list2):\n        if list1[i] <= list2[j]:\n            result.append(list1[i])\n            i += 1\n        else:\n            result.append(list2[j])\n            j += 1\n\n    # Append any remaining elements\n    while i < len(list1):\n        result.append(list1[i])\n        i += 1\n\n    while j < len(list2):\n        result.append(list2[j])\n        j += 1\n\n    return result\n\n\ndef test_merge_sorted_lists():\n    \"\"\"Test the merge_sorted_lists function with various cases.\"\"\"\n    # Test 1: Basic merge\n    assert merge_sorted_lists([1, 3, 5], [2, 4, 6]) == [1, 2, 3, 4, 5, 6]\n\n    # Test 2: One list is empty\n    assert merge_sorted_lists([], [1, 2, 3]) == [1, 2, 3]\n    assert merge_sorted_lists([1, 2, 3], []) == [1, 2, 3]\n\n    # Test 3: Both lists are empty\n    assert merge_sorted_lists([], []) == []\n\n    # Test 4: All elements in list1 are smaller\n    assert merge_sorted_lists([1, 2], [3, 4]) == [1, 2, 3, 4]\n\n    # Test 5: All elements in list2 are smaller\n    assert merge_sorted_lists([3, 4], [1, 2]) == [1, 2, 3, 4]\n\n    # Test 6: Duplicates\n    assert merge_sorted_lists([",
