    "output_text": "```python\nfrom typing import List, Dict, Set, Tuple\nfrom collections import defaultdict\n\n\ndef topological_sort(graph: Dict[int, List[int]]) -> List[int]:\n    \"\"\"\n    Perform topological sorting on a directed acyclic graph.\n    \n    Args:\n        graph: A dictionary where keys are nodes and values are lists of nodes\n               that the key has an edge to (i.e., key -> value means key has an edge to value).\n    \n    Returns:\n        A list of nodes in topological order.\n    \n    Raises:\n        ValueError: If the graph contains a cycle.\n    \"\"\"\n    # Build in-degree map and adjacency list\n    in_degree: Dict[int, int] = {}\n    all_nodes: Set[int] = set()\n    \n    for node in graph:\n        all_nodes.add(node)\n        if node not in in_degree:\n            in_degree[node] = 0\n        for neighbor in graph[node]:\n            all_nodes.add(neighbor)\n            if neighbor not in in_degree:\n                in_degree[neighbor] = 0\n            in_degree[neighbor] += 1\n    \n    # Initialize queue with nodes that have in-degree 0\n    from collections import deque\n    queue = deque()\n    for node in all_nodes:\n        if in_degree[node] == 0:\n            queue.append(node)\n    \n    result: List[int] = []\n    \n    while queue:\n        node = queue.popleft()\n        result.append(node)\n        for neighbor in graph.get(node, []):\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    \n    # Check for cycle\n    if len(result) != len(all_nodes):\n        raise ValueError(\"Graph contains a cycle\")\n    \n    return result\n\n\ndef has_cycle(graph: Dict[int, List[int]]) -> bool:\n    \"\"\"\n    Check if a directed graph has a cycle.\n    \n    Args:\n        graph: A dictionary where keys are nodes and values are lists of nodes\n               that the key has an edge to.\n    \n    Returns:\n        True if the graph has a cycle, False otherwise.\n    \"\"\"\n    # Use the topological sort to detect cycles\n    try:\n        topological_sort(graph)\n        return False\n    except ValueError:\n        return True\n\n\ndef test_topological_sort_simple",
