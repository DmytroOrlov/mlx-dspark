    "output_text": "```python\nfrom typing import Optional\nfrom collections import Counter\n\n\ndef first_non_repeating_char(s: str) -> Optional[str]:\n    \"\"\"\n    Returns the first non-repeating character in a string.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        The first character that appears only once in the string,\n        or None if no such character exists.\n    \"\"\"\n    if not s:\n        return None\n\n    count = Counter(s)\n    for char in s:\n        if count[char] == 1:\n            return char\n    return None\n\n\nif __name__ == \"__main__\":\n    import unittest\n\n    class TestFirstNonRepeatingChar(unittest.TestCase):\n        def test_empty_string(self):\n            self.assertIsNone(first_non_repeating_char(\"\"))\n\n        def all_repeating(self):\n            self.assertIsNone(first_non_repeating_char(\"aabbcc\"))\n\n        def test_single_char(self):\n            self.assertEqual(first_non_repeating_char(\"a\"), \"a\")\n\n        def test_first_non_repeating(self):\n            self.assertEqual(first_non_repeating_char(\"abac\"), \"b\")\n\n        def test_no_non_repeating(self):\n            self.assertIsNone(first_non_repeating_char(\"aabb\"))\n\n        def test_mixed(self):\n            self.assertEqual(first_non_repeating_char(\"aabbc\"), \"c\")\n\n        def test_all_unique(self):\n            self.assertEqual(first_non_repeating_char(\"abc\"), \"a\")\n\n        def test_case_sensitive(self):\n            self.assertEqual(first_non_repeating_char(\"AaBb\"), \"A\")\n\n        def test_spaces(self):\n            self.assertEqual(first_non_repeating_char(\"a a\"), \"a\")\n\n        def test_numbers_in_string(self):\n            self.assertEqual(first_non_repeating_char(\"11223\"), \"3\")\n\n    unittest.main()\n```",
